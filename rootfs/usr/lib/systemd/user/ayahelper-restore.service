[Unit]
Description=ayaHelper - re-apply saved hardware settings
# Ring LED state lives in sysfs and does not survive a reboot. The gamepad and
# keyboard MCUs keep their own settings, so re-sending is a harmless no-op that
# also covers a firmware reset.
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=/usr/bin/ayahelper --restore
# First boot has nothing saved; --restore refuses rather than writing defaults.
SuccessExitStatus=0 1

[Install]
WantedBy=graphical-session.target
